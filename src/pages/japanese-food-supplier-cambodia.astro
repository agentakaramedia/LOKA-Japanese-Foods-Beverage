---
import { opt } from '../lib/img';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';

interface Origin {
  name: string;
  flag: string;
  alt: string;
  rounded?: boolean;
  bordered?: boolean;
}

const origins: Origin[][] = [
  [
    { name: 'China', flag: '/uploads/2025/05/flag-5.png', alt: 'flag 5', rounded: true },
    { name: 'Vietnam', flag: '/uploads/2025/05/flag-6.png', alt: 'flag 6' },
  ],
  [
    { name: 'Malaysia', flag: '/uploads/2025/05/flag-1-3.png', alt: 'flag 1 (3)' },
    { name: 'Philippine', flag: '/uploads/2025/05/flag-1-4.png', alt: 'flag 1 (4)' },
  ],
  [{ name: 'Japanese', flag: '/uploads/2025/05/flag-1-2.png', alt: 'flag 1 (2)', bordered: true }],
];

const modes = [
  { label: 'Sea', icon: 'water' },
  { label: 'Air', icon: 'fighter-jet' },
  { label: 'Truck', icon: 'truck' },
] as const;
---

<Base
  title="Japanese Food Supplier in Cambodia | Partner with LOKA"
  description="We import food from Japan and neighboring countries of Cambodia and deliver them to customers throughout Cambodia."
  ogImage="/uploads/2025/05/Untitled-1.jpg"
>
  <Hero
    image="/uploads/2025/10/IMG_9754-2-1-2048x1150.jpg"
    mobileImage="/uploads/2025/05/media-resource-1.jpg"
    title="GET YOUR PRODUCT DISCOVERED"
    class="supplier-hero"
  />

  <div class="band band--navy" aria-hidden="true"></div>

  <section class="market">
    <div class="market__head">
      <h2>The Developing Cambodian Market</h2>
    </div>
    <div class="market__text">
      <p>LOKA is a leading company specializing in Japanese food distribution in Cambodia.</p>
      <p>Cambodia continues to be one of the most dynamic and promising markets in ASEAN.<br />While economic growth has slightly stabilized compared to previous years, the country maintains steady development driven by strong domestic demand, infrastructure investment, and the recovery of tourism and exports.</p>
      <p>With rising incomes and a growing middle class, consumer interest in high-quality imported food has expanded significantly, especially in major cities such as Phnom Penh, Siem Reap, and Sihanoukville.<br />Japanese food products, known for their safety and premium quality, are increasingly valued by both individuals and businesses in Cambodia’s food industry.</p>
      <p>As the market continues to mature, demand for reliable purchasing and distribution, consistent quality, and professional service will only grow.</p>
      <p>LOKA aims to strengthen the connection between Cambodia and Japan through food.</p>
    </div>
  </section>

  <section class="split split--grey split--center split--trail">
    <div class="split__col split__copy">
      <h2 class="split__title">Strengths of our overseas partners</h2>
      <div class="split__text">
        <p>We have partner companies based in Japan and Thailand. This enables us to conduct research activities in Japan, Thailand, and neighboring countries.</p>
        <p>We can also conduct transactions in the local currencies of Japan and Thailand, allowing us to respond flexibly to the needs of our clients in Cambodia and Japan, Thailand, and other neighboring countries. This means that our customers in Cambodia only need to pay us in US dollars to receive the products we handle in each country.</p>
      </div>
    </div>
    <div class="split__col split__media">
      <img src={opt('/uploads/2025/05/Untitled-1.jpg', true)} alt="Map of LOKA partner locations in Japan, Thailand and Cambodia" loading="lazy" />
    </div>
  </section>

  <section class="split split--grey split--transport">
    <div class="split__col split__media split__media--cover">
      <img src={opt('/uploads/2025/05/Established-transportation-system.jpg', true)} alt="Refrigerated container being unloaded by forklift" loading="lazy" />
    </div>
    <div class="split__col split__copy">
      <h2 class="split__title">Established transportation system</h2>
      <div class="split__text">
        <p>We have established a transportation system that includes air cargo and refrigerated containers. Therefore, we handle goods in all temperature zones, from room temperature to refrigerated, chilled, and frozen goods.</p>
        <p>From Japan<br />・ Air cargo: 8 to 10 flights/month<br />・ Refrigerated containers: 1 time/month<br />・ Dry Container: 1 time/2-3 month</p>
        <p>From other neighboring countries (Bangkok, Ho Chi Minh, Malaysia)<br />・ Land Transportation:  Weekly<br />・ Freezer Container: 1 time/2-3 month</p>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="split split--center split--lots">
    <div class="split__col split__copy">
      <h2 class="split__title">Trading of goods in small lots</h2>
      <div class="split__text">
        <p>We have an established transportation system, including containers, which is necessary for the transportation of goods. Therefore, although the product determines the minimum quantity, we can handle products in much smaller lot sizes, such as one piece or one pack.</p>
      </div>
    </div>
    <div class="split__col split__media">
      <img src={opt('/uploads/2025/05/New-Emerging-Brands.jpg', true)} alt="LOKA Food & Beverage logo" loading="lazy" />
    </div>
  </section>

  <div class="band" aria-hidden="true"></div>

  <section class="origins" aria-label="Import origins and transport modes">
    {origins.map((row) => (
      <div class="origins__row">
        {row.map((o) => (
          <div class="origin">
            <div class="origin__flag">
              <img
                src={o.flag}
                alt={o.alt}
                class:list={[{ 'is-rounded': o.rounded, 'is-bordered': o.bordered }]}
                loading="lazy"
              />
            </div>
            <div class="origin__info">
              <h3>{o.name}</h3>
              <ul class="modes">
                {modes.map((m) => (
                  <li><Icon name={m.icon} class="modes__icon" /><span>{m.label}</span></li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>

  <div class="trailing-space" aria-hidden="true"></div>
</Base>

<style>
  .band {
    height: 51px;
    background: #fff;
  }

  .band--navy {
    background: var(--loka-navy-2);
  }

  /* The Developing Cambodian Market */
  .market {
    display: flex;
    align-items: center;
    padding: 0 200px;
    background: var(--loka-navy-2);
    color: #fff;
  }

  .market__head {
    width: 50%;
    padding: 20px 0 20px 30px;
  }

  .market__head h2 {
    font-size: 60px;
    font-weight: 900;
    line-height: 1;
    color: #fff;
  }

  .market__text {
    width: 50%;
    padding: 30px 10px;
  }

  /* Two-column sections */
  .split {
    display: flex;
    gap: 40px;
    padding: 0 200px;
    background: #fff;
    color: #000;
  }

  .split--grey {
    background: #f0f0f0;
  }

  .split--center {
    align-items: center;
  }

  /* The original reserves an empty third column, so both columns are 480px wide */
  .split--trail {
    padding-right: 240px;
  }

  .split__col {
    width: 50%;
    flex: 1 1 0;
  }

  .split__copy {
    display: flex;
    flex-direction: column;
  }

  .split__title {
    padding: 80px 10px 10px;
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    color: #000;
  }

  .split__text {
    padding: 10px;
  }

  .split__media {
    padding: 10px;
  }

  .split__media img {
    display: block;
    width: 100%;
    border-radius: 10px;
  }

  .split--grey.split--center .split__media {
    padding-top: 80px;
  }

  .split--transport .split__media {
    padding: 70px 0 14px;
  }

  .split--transport .split__media img {
    height: 350px;
    object-fit: cover;
  }

  .split--transport .split__title {
    padding: 80px 10px 10px;
  }

  .split--lots {
    padding-block: 7px;
  }

  .split--lots .split__title {
    padding-top: 10px;
  }

  /* Origins */
  .origins__row {
    display: flex;
    padding: 0 200px;
  }

  .origin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 50%;
    margin: 10px;
    padding: 10px;
  }

  .origin__flag {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 10px;
  }

  .origin__flag img {
    width: 60%;
  }

  .origin__flag img.is-rounded {
    border-radius: 10px;
  }

  .origin__flag img.is-bordered {
    border: 3px solid #000;
  }

  .origin__info {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    padding: 10px;
  }

  .origin__info h3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
    color: #000;
  }

  .modes {
    display: flex;
    flex-wrap: wrap;
    margin-inline: -20px;
  }

  .modes li {
    display: flex;
    align-items: center;
    margin-inline: 20px;
    font-size: 18px;
    line-height: 1.6;
    color: #0d141c;
  }

  .modes :global(.modes__icon) {
    width: 25px;
    height: 25px;
    margin-right: 5px;
    color: var(--loka-navy);
  }

  .trailing-space {
    height: 306px;
  }

  @media (max-width: 1024px) {
    .market,
    .split--transport,
    .split--lots {
      padding-inline: 0;
    }

    .split--trail,
    .origins__row {
      padding-inline: 30px;
    }

    .split--trail {
      padding-right: 70px;
    }

    .split--transport .split__media {
      padding-left: 10px;
    }
  }

  @media (max-width: 767px) {
    .market {
      flex-direction: column;
      align-items: center;
      padding: 0 30px;
    }

    .market__head,
    .market__text {
      width: 100%;
    }

    .market__head {
      padding: 30px 0 0;
    }

    /* The original 60px heading overflows a phone screen; keep it as large as fits */
    .market__head h2 {
      font-size: min(60px, 13vw);
    }

    .split {
      flex-direction: column;
      gap: 0;
      padding: 0 30px;
    }

    .split__col {
      width: 100%;
    }

    .split--transport {
      padding: 0;
    }

    .split--transport .split__media {
      padding: 70px 30px 0;
    }

    .split--transport .split__title {
      padding: 110px 40px 10px;
    }

    .split--transport .split__text {
      padding: 10px 40px 20px;
    }

    .split--lots .split__title {
      padding-top: 10px;
    }

    .origins__row {
      flex-direction: column;
      padding: 0 30px;
    }

    .origin {
      grid-template-columns: 1fr;
      width: auto;
    }

    .origin__flag {
      align-items: center;
    }

    .origin__info {
      gap: 10px;
      text-align: center;
    }

    .modes {
      justify-content: center;
      margin-inline: -10px;
      padding-left: 20px;
    }

    .modes li {
      margin-inline: 10px;
    }
  }
</style>
