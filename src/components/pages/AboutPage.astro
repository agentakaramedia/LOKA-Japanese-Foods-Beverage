---
import { opt } from '../../lib/img';
import { clients } from '../../data/logos';
import Base from '../../layouts/Base.astro';
import sections from '../../data/about.json';
import { translator, type Lang } from '../../data/ja';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translator(lang);
---

<Base
  title="About Us /The word “LOKA” is a Khmer word meaning “the world,”"
  description="LOKA Japanese FOODBEVERAGE, are a food import and wholesale business that started operations in April 2014.With over 500 customers and..."
  ogImage="/uploads/2025/05/loka-logo-background.png"
  lang={lang}
  fonts={`family=Poppins:wght@300;400;500;600;700&family=Noto+Sans+Khmer:wght@400;500${lang === 'ja' ? '&family=Noto+Sans+JP:wght@400;500' : ''}`}
>
  <div class="loka-about-page">
    <section class="lk-hero">
      <div class="lk-wrap">
        <h1>{t("Know More About LOKA Japanese Foods & Beverage")}</h1>
      </div>
    </section>

    {sections.map((s) => (
      <section class:list={['lk-sec', { 'lk-blue': s.blue }]} id={s.clients ? 'clients' : undefined}>
        <div class="lk-wrap">
          <h2 set:html={t(s.title)} />
          <p set:html={t(s.text)} />
          {s.clients ? (
            <div class="lk-clients">
              <h3>{t('LOKA’s Clients')}</h3>
              <ul>
                {clients.map((c) => (
                  <li class:list={{ 'lk-solid': c.solid }}><img src={opt(c.src, true)} alt={c.name} loading="lazy" decoding="async" /></li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="lk-gallery">
              {s.images.map((img) => (
                <figure><img src={opt(img.src, true)} alt={img.alt} loading="lazy" decoding="async" /></figure>
              ))}
            </div>
          )}
        </div>
      </section>
    ))}

    <div class="lk-foot">
      <div class="lk-wrap">
        <img src="/images/brand/seats-inc.png" width="1701" height="412" alt="S.E.A.T.S Inc. - South East Asia Trading and Service" loading="lazy" />
      </div>
    </div>
  </div>
</Base>

<style>
  .loka-about-page {
    --lk-navy: #1b3a9a;
    --lk-text: #2c3e94;
    font-family: 'Poppins', 'Noto Sans JP', 'Noto Sans Khmer', Arial, sans-serif;
    color: var(--lk-text);
    background: #fff;
    line-height: 1.6;
    overflow: hidden;
    text-align: left;
  }

  /* The original block is pulled 15px under the header on desktop, and sits below a
     61px white spacer on tablet/mobile. */
  @media (min-width: 1025px) {
    .loka-about-page {
      margin-top: -15px;
    }
  }

  @media (max-width: 1024px) {
    .loka-about-page {
      padding-top: 61px;
    }
  }

  .loka-about-page img {
    max-width: 100%;
    display: block;
  }

  .loka-about-page p {
    margin: 0;
  }

  .loka-about-page h1,
  .loka-about-page h2 {
    font-family: inherit;
    line-height: 1.35;
  }

  .lk-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero */
  .lk-hero {
    position: relative;
    height: clamp(240px, 32vw, 460px);
    display: flex;
    align-items: center;
    background: #1b3a9a url('/opt/2025/10/IMG_9754-2-1-2048x1150.webp') center 30% / cover no-repeat;
  }

  .lk-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 30, 90, 0.55) 0%, rgba(15, 30, 90, 0.25) 55%, rgba(15, 30, 90, 0.05) 100%);
  }

  .lk-hero .lk-wrap {
    position: relative;
    width: 100%;
  }

  .lk-hero h1 {
    color: #fff;
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 500;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
  }

  /* Content sections */
  .lk-sec {
    padding: 48px 0 52px;
    background: #fff;
  }

  .lk-sec.lk-blue {
    background: var(--lk-navy);
    color: #fff;
  }

  .lk-sec h2 {
    font-size: 26px;
    font-weight: 500;
    color: var(--lk-text);
    margin: 0 0 14px;
  }

  .lk-sec.lk-blue h2 {
    color: #fff;
  }

  .lk-sec p {
    font-size: 15px;
    line-height: 1.75;
    text-align: justify;
    text-justify: inter-word;
    color: inherit;
  }

  .lk-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 26px;
  }

  .lk-gallery figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e9ecf5;
  }

  .lk-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .lk-gallery figure:hover img {
    transform: scale(1.05);
  }

  /* "LOKA's Clients" logo grid: navy title bar over a checkerboard of two lavender tints,
     as in the client mock-up. */
  .lk-clients {
    margin-top: 32px;
  }

  .lk-clients h3 {
    margin: 0 0 12px;
    padding: 6px 12px;
    background: #2f3f8f;
    color: #fff;
    font-family: inherit;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
  }

  .lk-clients ul {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lk-clients li {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 7%;
    background: #eceefb;
  }

  /* Ten columns: shade alternate tiles, flipping each row. */
  .lk-clients li:nth-child(20n + 1),
  .lk-clients li:nth-child(20n + 3),
  .lk-clients li:nth-child(20n + 5),
  .lk-clients li:nth-child(20n + 7),
  .lk-clients li:nth-child(20n + 9),
  .lk-clients li:nth-child(20n + 12),
  .lk-clients li:nth-child(20n + 14),
  .lk-clients li:nth-child(20n + 16),
  .lk-clients li:nth-child(20n + 18),
  .lk-clients li:nth-child(20n + 20) {
    background: #d3d7f7;
  }

  .lk-clients img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    /* Drops the white box behind logos supplied without transparency. */
    mix-blend-mode: multiply;
  }

  .lk-clients .lk-solid img {
    mix-blend-mode: normal;
  }

  .lk-foot {
    padding: 26px 0;
  }

  .lk-foot img {
    height: 48px;
    width: auto;
  }

  @media (max-width: 900px) {
    .lk-gallery {
      gap: 14px;
    }

    /* An odd column count gives the checkerboard from plain odd/even. */
    .lk-clients ul {
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    .lk-clients li:nth-child(n) {
      background: #eceefb;
    }

    .lk-clients li:nth-child(odd) {
      background: #d3d7f7;
    }
  }

  @media (max-width: 640px) {
    .lk-wrap {
      padding: 0 16px;
    }

    .lk-hero {
      height: 220px;
      background-image: url('/opt/2025/10/IMG_9754-2-1-scaled-800.webp');
    }

    .lk-hero h1 {
      font-size: 24px;
    }

    .lk-sec {
      padding: 36px 0 40px;
    }

    .lk-sec h2 {
      font-size: 21px;
    }

    .lk-sec p {
      text-align: left;
    }

    .lk-gallery {
      grid-template-columns: 1fr;
    }

    .lk-clients h3 {
      font-size: 17px;
    }

    .lk-clients ul {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
  }
</style>
