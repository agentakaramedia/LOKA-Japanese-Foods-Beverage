---
import { opt } from '../lib/img';
import { NAV, LINKS } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && path.startsWith(href);
const jaHref = LINKS.japanese + path.replace(/^\//, '');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="LOKA Japanese Foods & Beverage – Home">
      <img src={opt('/uploads/2025/06/loka.png', true)} width="2048" height="374" alt="LOKA Japanese Foods & Beverage" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li class:list={[{ 'is-active': isActive(item.href) }]}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="site-header__lang" href={jaHref} hreflang="ja" lang="ja" title="日本語">
      <img src="/images/flags/ja.png" width="18" height="12" alt="日本語" />
    </a>

    <button class="site-header__burger" type="button" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false" data-nav-open>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <div class="mobile-nav__overlay" data-nav-close></div>
  <nav class="mobile-nav__panel" aria-label="Mobile">
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const root = document.getElementById('mobile-nav');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-nav-open]');
  if (root && openBtn) {
    const close = () => {
      root.classList.remove('is-open');
      openBtn.setAttribute('aria-expanded', 'false');
      window.setTimeout(() => (root.hidden = true), 300);
      openBtn.focus();
    };
    const open = () => {
      root.hidden = false;
      requestAnimationFrame(() => root.classList.add('is-open'));
      openBtn.setAttribute('aria-expanded', 'true');
      root.querySelector('a')?.focus();
    };
    openBtn.addEventListener('click', open);
    root.querySelector('[data-nav-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) close();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 100;
    background: var(--loka-header-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    max-width: var(--container);
    height: 125px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .site-header__logo {
    flex: 0 0 auto;
    display: block;
    padding: 5px 0;
  }

  .site-header__logo img {
    display: block;
    width: 380px;
    max-width: 380px;
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    color: #fff;
  }

  .site-nav span {
    position: relative;
    padding: 1px 0;
  }

  .site-nav span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--loka-red);
    transition: width 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .site-nav a:hover span::after,
  .site-nav a:focus-visible span::after,
  .site-nav .is-active span::after {
    width: 100%;
  }

  .site-nav a:hover,
  .site-nav .is-active a {
    color: rgba(255, 255, 255, 0.8);
  }

  .site-header__lang {
    display: flex;
    align-items: center;
    margin-left: 115px;
    margin-right: 5px;
  }

  .site-header__lang img {
    display: block;
  }

  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0 10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .site-header__burger span {
    display: block;
    height: 2px;
    background: #fff;
  }

  /* Woodmart switches to the mobile header at 1024px */
  @media (max-width: 1024px) {
    .site-header {
      padding-top: 38px;
    }

    .site-header__inner {
      height: 60px;
      padding: 0 5px 0 15px;
    }

    .site-header__logo img {
      width: 200px;
      max-width: 200px;
    }

    .site-nav {
      display: none;
    }

    .site-header__lang {
      margin-left: auto;
      margin-right: 15px;
    }

    .site-header__burger {
      display: flex;
    }
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 500;
  }

  .mobile-nav__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .mobile-nav__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 300px;
    max-width: 85vw;
    overflow-y: auto;
    background: #fff;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-nav.is-open .mobile-nav__overlay {
    opacity: 1;
  }

  .mobile-nav.is-open .mobile-nav__panel {
    transform: none;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 5px 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.105);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    color: #333;
  }

  .mobile-nav a:hover,
  .mobile-nav a.is-active {
    color: var(--loka-red);
  }
</style>
